// =========================
// ORDER MODEL (Simplified version)
// =========================
// NOTE: Current Order uses items JSONB (supports multiple products)
// This version is simplified with single productId/customerId
// Consider this for simpler use cases or add alongside existing

model OrderSimple {
  id          String      @id @default(uuid())
  orgId       String      @map("org_id")
  customerId  String      @map("customer_id")
  productId   String      @map("product_id")
  quantity    Int
  amount      Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  organization Organization @relation("OrderSimpleOrganization", fields: [orgId], references: [id], onDelete: Cascade)
  product       Product       @relation("OrderSimpleProduct", fields: [productId], references: [id])

  @@index([orgId])
  @@index([customerId])
  @@index([productId])
  @@map("order_simple")
}

// =========================
// PAYMENT MODEL (Simplified version)
// =========================
// NOTE: Current schema uses PaymentAttempt with more fields
// This is a simpler alternative - consider if you need this structure

model Payment {
  id          String        @id @default(uuid())
  orgId       String        @map("org_id")
  orderId     String        @map("order_id")
  ref         String        @unique
  providerRef String?       @map("provider_ref")
  amount      Float
  status      PaymentStatus @default(INITIATED)
  payload     Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  order Order @relation("PaymentOrder", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orderId])
  @@index([ref])
  @@map("payments")
}

// =========================
// TRACE MODEL (Simplified version)
// =========================
// NOTE: Current schema uses ProcessingTrace with more detailed fields
// This is a simpler alternative with status enum

model Trace {
  id        String      @id @default(uuid())
  orgId     String      @map("org_id")
  messageId String      @map("message_id")
  step      String
  data      Json?
  status    TraceStatus @default(RECEIVED)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([orgId])
  @@index([messageId])
  @@index([status])
  @@map("traces")
}

