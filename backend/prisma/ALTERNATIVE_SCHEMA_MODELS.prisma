// =========================
// NEW ENUMS (Add to existing schema)
// =========================

enum RuleType {
  KEYWORD
  INTENT
  FALLBACK
}

enum RuleTrigger {
  MESSAGE_RECEIVED
  ORDER_PLACED
  PAYMENT_CONFIRMED
}

enum RuleActionType {
  SEND_MESSAGE
  APPLY_TEMPLATE
  UPDATE_ORDER
}

// TemplateStatus already exists as string - can add as enum
enum TemplateStatusEnum {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// OrderStatus and PaymentStatus already exist - these match existing
enum OrderStatusEnum {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatusEnum {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

enum TraceStatus {
  RECEIVED
  PROCESSED
  ERROR
}

// =========================
// NEW RULE MODEL (Alternative to ConversationRule)
// =========================
// NOTE: Current schema uses ConversationRule with key/value JSON structure
// This is a more structured alternative with explicit type/trigger/action fields

model Rule {
  id        String      @id @default(uuid())
  orgId     String      @map("org_id")
  type      RuleType
  trigger   RuleTrigger
  action    RuleActionType
  pattern   String?     // e.g. keyword matching
  intent    String?     // e.g. parsed AI intent
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  organization Organization @relation("RuleOrganization", fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, type])
  @@index([orgId, trigger])
  @@map("rules")
}

